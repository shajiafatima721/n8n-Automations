{
  "name": "Lead → Google Sheets → Email → Telegram",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-1",
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "lead-form"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "PASTE_YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Sheet1",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ $json.body.name }}",
            "Email": "={{ $json.body.email }}",
            "Message": "={{ $json.body.message }}",
            "SubmittedAt": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "gsheets-1",
      "name": "Append to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [480, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "PASTE_CRED_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "you@yourdomain.com",
        "toEmail": "={{ $json.body.email }}",
        "subject": "We got your message — thanks!",
        "emailFormat": "text",
        "message": "Hi {{ $json.body.name }},\n\nThanks for reaching out! We received your message:\n\n\"{{ $json.body.message }}\"\n\nWe'll get back to you within 24 hours.\n\n— The Team",
        "options": {}
      },
      "id": "email-1",
      "name": "Send Confirmation Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [720, 300],
      "credentials": {
        "smtp": {
          "id": "PASTE_CRED_ID",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "PASTE_YOUR_TELEGRAM_CHAT_ID",
        "text": "📥 New lead!\nName: {{ $json.body.name }}\nEmail: {{ $json.body.email }}\nMessage: {{ $json.body.message }}",
        "additionalFields": {}
      },
      "id": "telegram-1",
      "name": "Notify in Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [960, 300],
      "credentials": {
        "telegramApi": {
          "id": "PASTE_CRED_ID",
          "name": "Telegram bot"
        }
      }
    }
  ],
  "connections": {
    "Lead Form Webhook": {
      "main": [
        [
          { "node": "Append to Google Sheets", "type": "main", "index": 0 }
        ]
      ]
    },
    "Append to Google Sheets": {
      "main": [
        [
          { "node": "Send Confirmation Email", "type": "main", "index": 0 }
        ]
      ]
    },
    "Send Confirmation Email": {
      "main": [
        [
          { "node": "Notify in Telegram", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "lead-gen" },
    { "name": "automation" }
  ]
}
